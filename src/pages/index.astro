---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const title = "Pet Health Blog";
---
<SiteLayout title={title}>
      <header class="home-intro">
        <p class="category">ペットと、健やかな毎日を。</p>
        <h1>大切な家族の健康を、<br />いっしょに考える。</h1>
        <p>ペットの健康・病気について、わかりやすくお届けします。</p>
      </header>
      <section id="articles" aria-labelledby="articles-title">
        <h2 id="articles-title" class="section-title">記事一覧</h2>
        {posts.map(({ slug, data }) => <a class="article-preview" href={`/blog/${slug}/`}>
          {data.image && <img src={data.image.src} alt={data.image.alt} width={data.image.width} height={data.image.height} loading="lazy" />}
          <p class="date">{data.category} ・ <time datetime={data.publishDate}>{data.publishDate.replaceAll('-', '.')}</time></p>
          <h3>{data.titleLines?.join('') ?? data.title}</h3>
          <span>記事を読む →</span>
        </a>)}
      </section>
      <section id="about" class="about" aria-labelledby="about-title">
        <h2 id="about-title" class="section-title">このサイトについて</h2>
        <p>ペットの健康・病気について、獣看護師としての経験を交えて発信していくブログです。</p>
      </section>
</SiteLayout>
